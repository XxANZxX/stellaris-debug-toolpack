			background = {
				name = "background_notrans"
				spriteType = "GFX_tiles_frame_notrans"
				alwaysTransparent = yes
			}
		}
		iconType = {
			name = "icon"
			spriteType = "GFX_resource_consumer_goods"
			position = { x = 4 y = 5 }
			alwaysTransparent = yes
		}
		instantTextBoxType = {
			name = "amount"
			font = "font_text_14"
			text = "0 / 0"
			position = { x = 25 y = 2 }
			maxWidth = 70
			maxHeight = 24
			fixedSize = yes
			vertical_alignment = center
			alwaysTransparent = yes
		}
	}
	containerWindowType = {
		name = "order_selector"
		position = { x = 0 y = 0 }
		size = { width = 472 height = 10 }
		moveable = yes
		background = {
			name = "bg"
			quadTextureSprite = "GFX_tile_outliner_bg"
		}
		iconType = {
			name = "hex_bg"
			spriteType = "GFX_hex_bg"
			position = { x = -20 y = -12 }
			alwaysTransparent = yes
		}
		iconType = {
			name = "governor_line"
			quadTextureSprite = "GFX_line"
			position = { x = 3 y = 22 }
			alwaysTransparent = yes
		}
		instantTextBoxType = {
			name = "label"
			font = "font_header_20"
			text = "ORDERS"
			appendText = ":"
			position = { x = 20 y = 5 }
			maxWidth = 249
			maxHeight = 16
			fixedSize = yes
			text_color_code = "H"
			alwaysTransparent = yes
		}
		smoothListboxType = {
			name = "orders"
			position = { x = 10 y = 40 }
			priority = 100
			size = { x = 460 y = 0 }
			scrollbarType = "standardlistbox_slider_thick_small"
			offset = { x = -10 y = 0 }
		}
	}
	# Order entries
	containerWindowType = {
